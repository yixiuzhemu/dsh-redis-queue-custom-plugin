# ── dsh-redis-queue-custom-plugin ────────────────────────────────────────────
# Redis 连接本身由 dsh-redis-plugin 的 REDIS_* 变量决定（见该插件 .env.example）。
# 本文件仅列出队列消费插件自身可调的运行期变量样例；cordis.patch.yml 可用
# !!js "process.env.REDIS_QUEUE_* || 默认" 读取它们，实现按 stage 注入而不改代码。

# 队列 / key
REDIS_QUEUE_KEY=DSH:TASK
REDIS_QUEUE_DLQ_KEY=DSH:TASK:DLQ
REDIS_QUEUE_PROCESSING_KEY=DSH:TASK:processing

# 调度
REDIS_QUEUE_POLL_INTERVAL_MS=15000
REDIS_QUEUE_CONSUME_MODE=poll
REDIS_QUEUE_BATCH_SIZE=1

# 环境准入阈值
REDIS_QUEUE_MAX_CPU_RATIO=0.85
REDIS_QUEUE_MAX_MEM_RATIO=0.90
REDIS_QUEUE_MAX_SESSIONS=3

# 工作区
REDIS_QUEUE_WORKSPACE_ROOT=

# 模型路由默认值
REDIS_QUEUE_DEFAULT_PROVIDER=deepseek
REDIS_QUEUE_DEFAULT_MODEL=deepseek-chat
